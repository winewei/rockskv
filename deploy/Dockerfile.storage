# Dockerfile for RocksKV Storage Service
# IMPORTANT: This builds with REAL RocksDB for production use
FROM golang:1.21-bullseye AS builder

WORKDIR /app

# Install RocksDB build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libgflags-dev \
    libsnappy-dev \
    zlib1g-dev \
    libbz2-dev \
    liblz4-dev \
    libzstd-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Build RocksDB 10.7.5 from source
RUN cd /tmp && \
    git clone --depth 1 --branch v10.7.5 https://github.com/facebook/rocksdb.git && \
    cd rocksdb && \
    make shared_lib -j$(nproc) && \
    make install-shared INSTALL_PATH=/usr/local && \
    ldconfig && \
    cd / && rm -rf /tmp/rocksdb

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build with CGO enabled to use real RocksDB
RUN CGO_ENABLED=1 GOOS=linux go build -ldflags="-w -s" -o /rockskv-storage ./cmd/storage

# Final stage - use Debian base for glibc compatibility
FROM debian:bullseye-slim

# Install runtime dependencies for RocksDB
RUN apt-get update && apt-get install -y \
    libsnappy1v5 \
    liblz4-1 \
    libzstd1 \
    libbz2-1.0 \
    zlib1g \
    ca-certificates \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Copy RocksDB shared libraries from builder
COPY --from=builder /usr/local/lib/librocksdb.so* /usr/local/lib/
RUN ldconfig

COPY --from=builder /rockskv-storage /usr/local/bin/rockskv-storage

# Create non-root user and data directory
RUN useradd -r -s /bin/false rockskv && \
    mkdir -p /data/wal /data/sst && \
    chown -R rockskv:rockskv /data

USER rockskv

VOLUME ["/data"]
EXPOSE 9001

ENTRYPOINT ["rockskv-storage"]
CMD ["-c", "/etc/rockskv/storage.yaml"]
